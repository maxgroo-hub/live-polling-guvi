# Live Polling Application Environment Variables

# Backend server
# In standalone Docker Compose, backend listens on 8080 and frontend on 3000.
# In local/sandbox environments where port 8080 is reserved by the container reverse proxy,
# the Go backend is run on internal PORT=8081, and Vite proxies /api to http://127.0.0.1:8081.
PORT=8080
GIN_MODE=debug

# Database & Cache
MONGO_URI=mongodb://localhost:27017/polling_db
MONGO_DB_NAME=polling_db
REDIS_ADDR=localhost:6379
# Redis authentication password. Set ONLY if Redis server is configured with 'requirepass'.
# Leave empty for standard local unauthenticated Redis deployments.
REDIS_PASSWORD=

# Security & JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long

# CORS (Includes frontend dev server port 3000 and direct backend port 8080)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend environment (Vite)
# When Vite dev server runs, it proxies /api requests locally. For direct API access:
VITE_API_URL=http://localhost:8080
